# Website server settings. Generate real values with:
#   node directus/scripts/init-env.mjs
DIRECTUS_URL=http://localhost:8056
# Same value as DONATION_SERVICE_TOKEN in directus/.env.
DIRECTUS_SERVICE_TOKEN=
# Random secret (32+ characters) that signs payment and receipt links.
DONATION_SIGNING_SECRET=
# "mock" (local testing) or "stripe". Leave blank to disable checkout.
PAYMENT_PROVIDER=mock
# The mock provider is refused when NODE_ENV=production unless this is true.
ALLOW_MOCK_PAYMENTS=false

# Stripe (PAYMENT_PROVIDER=stripe). Use test-mode keys until you go live.
# Public address of this website; Stripe sends donors back here.
SITE_URL=http://localhost:3000
# Dashboard > Developers > API keys (sk_test_... / sk_live_...).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally, `stripe listen`
# prints one.
STRIPE_WEBHOOK_SECRET=
