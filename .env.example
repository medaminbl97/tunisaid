# Website server settings. Generate real values with:
#   node directus/scripts/init-env.mjs
DIRECTUS_URL=http://localhost:8056
# Same value as DONATION_SERVICE_TOKEN in directus/.env.
DIRECTUS_SERVICE_TOKEN=
# Random secret (32+ characters) that signs payment and receipt links.
DONATION_SIGNING_SECRET=
# Only "mock" exists today. Leave blank to disable checkout.
PAYMENT_PROVIDER=mock
# The mock provider is refused when NODE_ENV=production unless this is true.
ALLOW_MOCK_PAYMENTS=false
